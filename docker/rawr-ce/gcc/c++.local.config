# Meson native file for GCC containers.
# CC and CXX are set via environment (docker-compose) — meson picks them up
# automatically. This file handles anything supplementary to rawr's own
# meson.build that belongs to the test environment.
#
# -fmodules-ts is NOT here because it differs between GCC 11 and 14.
# It is passed via CXXFLAGS in docker-compose.yml instead.
# Meson appends CXXFLAGS from the environment during setup.
#
# Add testing-specific flags here, e.g.:
#   cpp_args = ['-Wshadow', '-Wextra']

[properties]
# Marker so meson --introspect can identify which environment this is.
rawr_test_environment = 'gcc'
